{
  "name": "layerworks",
  "private": true,
  "version": "0.1.0",
  "description": "Layerworks: a beginner-friendly configurator for keyboards on Vial firmware, with Keychron's extras",
  "license": "GPL-3.0-or-later",
  "homepage": "https://layerworks.tybyfy.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phazei/layerworks.git"
  },
  "bugs": {
    "url": "https://github.com/phazei/layerworks/issues"
  },
  "packageManager": "pnpm@11.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src/ hardware/",
    "test": "vitest run --maxWorkers=50%",
    "test:watch": "vitest",
    "vendor": "node scripts/vendor.mjs",
    "shots": "node scripts/screenshot.mjs",
    "hardware": "vitest run --config vitest.hardware.config.ts"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xz-decompress": "^0.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/w3c-web-hid": "^1.0.6",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "node-hid": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
